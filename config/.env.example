# config/.env.example — copy to config/.env and fill in your paths
#
# cp config/.env.example config/.env
#
# All paths must be absolute. There are no defaults that work out-of-the-box
# because model paths depend on where you cloned the repo and downloaded weights.

# ── Project root (used by docker-compose.yml for volume mounts) ───────────────
MEMENTO_DIR=/absolute/path/to/memento-rag

# ── Data directories ──────────────────────────────────────────────────────────
# Corpus folders: documents are read from INPUT_ROOT/<corpus_dir>, parsed output goes to
# OUTPUT_ROOT/<corpus_dir> (corpus_dir is set in config/domains/<DOMAIN_NAME>.yaml).
INPUT_ROOT=/absolute/path/to/memento-rag/data/input
OUTPUT_ROOT=/absolute/path/to/memento-rag/data/output

# ── Model weights (host paths — mounted read-only into containers) ─────────────
MODEL_PATH=/absolute/path/to/models/Qwen3-VL-Embedding-8B
RERANKER_MODEL_PATH=/absolute/path/to/models/Qwen3-VL-Reranker-8B
# Optional: weights for serving the answer model yourself (docker-compose service "reasoning", REASONING_GPU below;
# then REASONING_URL=http://localhost:8023 and REASONING_MODEL_NAME=/models/reasoning)
REASONING_MODEL_PATH=/absolute/path/to/models/Qwen3.5-397b-a17b

# ── The answer model: one OpenAI-compatible server for everything that writes or checks text ──────────────────────
# Library Chat, Document Chat, Library Upload's figure descriptions and gap tags, and command-line uploads all use it.
# Its URL without /v1, the model name it serves, and its key (empty for a server without a key). Never commit the key.
REASONING_URL=http://your-model-server:8001
REASONING_MODEL_NAME=qwen-flash-next
REASONING_API_KEY=

# "cloud" sends figure descriptions, contextual retrieval and command-line answers to the cloud API below instead of
# the answer model; chat answers use the model picked in the chat
REASONING_PROVIDER=local
CLOUD_REASONING_MODEL=qwen3.5-397b-a17b

# ── Service URLs (change only if running on non-default ports) ─────────────────
EMBEDDER_URL=http://localhost:8021
RERANKER_URL=http://localhost:8022
QDRANT_URL=http://localhost:6333
# Citation viewer as the USER'S BROWSER reaches it (the pipe only writes the link): through the proxy started in
# README step 6 (docker/Caddyfile). Users on other computers: http://<host>:8443/files
FILES_URL=http://localhost:8443/files
# Remote-access proxy port (compose service `proxy`): OpenWebUI at /, citation viewer at /files (login required)
# PROXY_PORT=8443
# The proxy answers only on the server itself; 0.0.0.0 serves other computers (README: Access from other computers)
# PROXY_BIND=127.0.0.1

# ── Neo4j (knowledge-graph store — dual-graph retrieval) ───────────────────
# The initial username is fixed to "neo4j" by the image (NEO4J_AUTH in
# docker-compose.yml); only the password is configurable. Generate a real
# password — same convention as WEBUI_SECRET_KEY below.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── Hybrid dense+BM25 search (query-time RRF fusion) ───────────────────────────
# HYBRID_ENABLED=true fuses dense + BM25 sparse search (Qdrant's server-side RRF)
HYBRID_ENABLED=true
HYBRID_PREFETCH_K=80

# ── Multimodal generation (image/chart pixels sent to the reasoning model) ────
# image/chart hits go to the reasoning model as images, at most MAX_IMAGES_TO_LLM per turn (cost, latency)
MAX_IMAGES_TO_LLM=6

# ── Graph retrieval (ablation switch — off / on) ─────────────────────
# GRAPH_RETRIEVAL=true adds graph-traversal candidates (memento/graph/query/graph_retrieval.py) to the search before
# reranking; needs a built graph (memento/graph/build/build_graph.py) and Neo4j
GRAPH_RETRIEVAL=false
GRAPH_MAX_HOPS=2
GRAPH_LIMIT=20
GRAPH_QUERY_USE_LLM=false
# Knowledge-graph ablation: "all" or "structural"
GRAPH_STREAMS=all

# GRAPH_BUILD=true adds each embedded document to the knowledge graph in Neo4j (per-chunk model extraction); in bulk:
# `python -m memento.graph.build.build_graph --domain <name> --all`
GRAPH_BUILD=false
# Model for the graph's entity and relation extraction: local (REASONING_URL) or cloud (OPENAI_BASE_URL). Default: local
# ENRICH_PROVIDER=local

# RESEARCH_GAP_TAG=true marks passages that state limitations, open questions or future work at upload; the
# research-gap ledger is built from them (memento/ingestion/README.md). Default: false
# RESEARCH_GAP_TAG=false

# ── GPU assignments — override docker-compose.yml defaults without editing it ──
# (docker-compose.yml defaults: MINERU_GPU=0, EMBEDDER_GPU=1, RERANKER_GPU=2)
# One GPU each for the parser, the embedder and the reranker.
MINERU_GPU=0
EMBEDDER_GPU=1
RERANKER_GPU=2
# Share of the GPU's memory vLLM may use for the embedder / reranker (0.5 of a 40 GB card leaves room
# for other users of the same card; raise it on a dedicated GPU).
EMBEDDER_GPU_MEM=0.5
RERANKER_GPU_MEM=0.5
# Only used if you uncomment the optional local `reasoning` service.
# REASONING_GPU=3

# Pages MinerU cross-batches per GPU forward pass. 64 is MinerU's default —
# change as needed.
# MINERU_PROCESSING_WINDOW_SIZE=64
# MINERU_VLM_PRELOAD=false

# ── Qdrant collection names (change only if deploying multiple instances) ──────
# Default: the domain profile's collection_prefix (collections <prefix>-rag, <prefix>-rag-ocr, …).
# COLLECTION_PREFIX=
# The default library's collection. Default: <collection_prefix of DOMAIN_NAME>-rag.
# MEMENTO_DEFAULT_COLLECTION=

# ── Knowledge-graph entity registry (dual-graph retrieval) ─────────────────
# Selects memento/graph/registries/entity_registry_{ENTITY_REGISTRY}.py; for another domain add a registry module
# (see memento/graph/registry_base.py) and set this to its name.
ENTITY_REGISTRY=ceramics

# ── Embedding dimensions (must match the model; do not change for Qwen3-VL) ───
EMBED_DIM=4096

# ── Ingestion concurrency (shared by the CLI pipeline and the OpenWebUI ────────
# ── ingestion pipe — these are also exposed there as overridable Valves) ───────
PARSE_WORKERS=8
EMBED_WORKERS=8
EMBED_BATCH_SIZE=2

# ── MinerU backend ─────────────────────────────────────────────────────────────
# Options: vlm-engine (default, best quality), hybrid-engine, pipeline (OCR) —
# canonical MinerU 3.4.0+ names (pre-3.4.0 used vlm-auto-engine/hybrid-auto-engine,
# still accepted as deprecated aliases but not used here).
MINERU_BACKEND=vlm-engine
MINERU_API_URL=http://localhost:8010
# Look-alike characters in parsed text are checked against the PDF's own text layer when a document is parsed;
# 0 switches this off (memento/ingestion/text_layer.py). Default: 1
# TEXT_LAYER_CHECK=1

# ── PostgreSQL for OpenWebUI ───────────────────────────────────────────────────
# Run: podman-compose --env-file config/.env up -d postgres  (or scripts/services.sh start postgres)
# OpenWebUI will auto-create its schema on first start.
# Leave blank to use OpenWebUI's default SQLite (single-user only).
DATABASE_URL=postgresql://owui:changeme@localhost:5433/openwebui
# Explicit credentials — used by docker-compose.yml postgres service
POSTGRES_USER=owui
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openwebui

# ── OpenWebUI secret key ──────────────────────────────────────────────────────
# Signs all JWT session tokens. Generate once per server and keep secret.
#
# Must be set to a non-empty value: scripts/services.sh exports every var in
# this file (`set -a; source .env`), and OpenWebUI's auto-generate fallback
# only triggers when the var is completely UNSET — an exported empty string
# (WEBUI_SECRET_KEY=) is treated as "set to empty" and fails hard with
# "WEBUI_SECRET_KEY is not set. It is a hard requirement when authentication
# is enabled." Generate a real value:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=changeme_generate_a_random_value

# ── OpenWebUI branding (optional) ─────────────────────────────────────────────
# Absolute path to a PNG logo to use as favicon and logo inside OpenWebUI.
# Leave blank to use the default OpenWebUI logo.
WEBUI_LOGO=
# App name shown in the browser tab / sidebar. Leave blank to use OpenWebUI's default.
WEBUI_NAME=Memento
# Host port OpenWebUI listens on (scripts/services.sh). Leave blank for the default (8086).
OPENWEBUI_PORT=8086

# ── Cloud API (any OpenAI-compatible endpoint) ─────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here

# ── A second library in the same Open WebUI (scripts/setup_openwebui.py study) ──
# Its id suffix (functions memento_query_<id>, memento_ingestion_<id>; models memento-query-<id>, …), its domain
# profile (its collection: <collection_prefix>-rag), its group, and its name in the admin lists.
# Defaults: polymer, polymer-engineering, "User study", "user study"
# SECOND_LIBRARY_ID=
# SECOND_LIBRARY_DOMAIN=
# SECOND_LIBRARY_GROUP=
# SECOND_LIBRARY_NAME=
# Evaluation scripts' local answer model (evaluation/RQ4/*). Default: http://localhost:8090/v1
# LOCAL_LLM_BASE_URL=http://localhost:8090/v1

# ── Accounts and the general prompt ─────────────────────────────────────────────
# Admin API key for scripts/setup_openwebui.py when it runs without --email/--password (Open WebUI: Settings,
# Account, API keys)
# OPENWEBUI_API_KEY=
# Group new accounts join (may upload and ask). Default: members
MEMENTO_MEMBER_GROUP=members
# Who built Memento, as the general prompt states it ("at <this>"). Leave blank to name only the thesis.
MEMENTO_BUILT_BY=

# ── Query pipe: thinking and answer verification (Valve defaults) ──
# THINKING_AUTO=false          # let the router switch thinking off for simple questions
# THINKING_BUDGET=12288        # cap on thinking tokens per answer (vLLM thinking_token_budget; 0 = no cap)
# VALIDATION=false             # verify answers against their sources before showing them (RQ3)
# VALIDATION_STRATEGY=A        # A = revise failing statements, C = remove them
# VALIDATION_MAX_ROUNDS=2      # revision rounds for strategy A

# ── Literature check of the research gaps (memento/research_gaps/literature.py) ────
# Semantic Scholar: a key gives 1 search per second, no daily cap. Request one at https://www.semanticscholar.org/product/api
S2_API_KEY=
# OpenAlex: a free key gives $1 of usage a day (about 1,000 searches); without one about 100.
# Get it from: https://openalex.org/settings/api
OPENALEX_API_KEY=
# An offline paper database, only ever read. Its keyword index comes from scripts/build_alexandria_index.py, its
# full-text lookup from scripts/build_fulltext_paths.py.
# ALEXANDRIA_DB=/absolute/path/to/paper-database
# 1 also gives the judge the best-matching passages of papers the database holds in full; needs ALEXANDRIA_DB and the
# lookup (memento/research_gaps/fulltext.py). Default: 0
# Those passages go to REASONING_URL, RERANKER_URL and VERIFIER_URL (if set): point these only at servers allowed to
# hold that text. Cloud models never receive them.
# LITERATURE_FULLTEXT=0
